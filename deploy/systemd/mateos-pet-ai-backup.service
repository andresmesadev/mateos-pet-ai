[Unit]
Description=Mateos Pet AI encrypted PostgreSQL backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mateos-pet-ai
EnvironmentFile=-/etc/mateos-pet-ai/backup.conf
ExecStart=/home/ubuntu/mateos-pet-ai/scripts/backup-database.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/mateos-pet-ai
