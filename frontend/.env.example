# URL base del backend Express (sin barra final)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Admin dashboard (NextAuth Credentials)
ADMIN_EMAIL=admin@mateospet.com
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Super admin: muestra pestaña "Admin" en el nav y habilita /dashboard/admin
# Poner true solo en el entorno de administración de la plataforma
NEXT_PUBLIC_SUPER_ADMIN=false

# Secreto compartido para rutas internas (X-Internal-Token) — debe coincidir
# EXACTAMENTE con INTERNAL_API_SECRET en backend/.env
INTERNAL_API_SECRET=

# Empleados operativos por WhatsApp (solo habilitar tras validar migraciones y ruta).
OPERATOR_WHATSAPP_ENABLED=false
OPERATOR_CHANNEL_HMAC_KEY=
OPERATOR_CHANNEL_KEY_VERSION=v1
OPERATOR_ADMIN_AUTHORITY_ENABLED=true
