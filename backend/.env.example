# =============================================================================
# Mateos Pet AI — Backend
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# =============================================================================

# PostgreSQL (Neon u otro). Debe incluir pgvector para memoria semántica.
# Ejemplo Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# OpenAI — análisis de mensajes, respuestas, embeddings y Whisper (audio)
OPENAI_API_KEY=

# Meta WhatsApp Cloud API — Developer Console > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Secret (Meta) — validación HMAC del webhook POST (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Puerto del servidor Express (default: 3000)
PORT=3000

# Entorno y observabilidad
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=

# Google Calendar — Service Account (compartir calendario con el email de la SA)
# GOOGLE_PRIVATE_KEY: pegar la clave con saltos de línea como \n
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Stripe — pagos por suscripción SaaS
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs: Dashboard > Products > crear plan mensual
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
# URL del frontend (para redireccionamiento Stripe en onboarding)
FRONTEND_URL=http://localhost:3001

# Recordatorios se envían automáticamente a las 9AM (America/Bogota)
# Incluye: citas del día siguiente, vacunas por vencer (15 días) y grooming (30+ días)
# Requiere WHATSAPP_PHONE_NUMBER_ID y WHATSAPP_ACCESS_TOKEN

# Opcional — entorno Node
# NODE_ENV=development
