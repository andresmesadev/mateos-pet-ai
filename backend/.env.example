# =============================================================================
# Huella Nex — Backend
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# Set false for dashboard-only tests: blocks WhatsApp ingress, sends and worker claims.
WHATSAPP_ENABLED=true
# =============================================================================

# PostgreSQL con pgvector. En la VPS, usar el hostname interno "db" de Compose.
# Ejemplo: postgresql://mateos:password@db:5432/mateos
DATABASE_URL=

# OpenAI — análisis de mensajes, respuestas, embeddings y Whisper (audio)
OPENAI_API_KEY=

# Meta WhatsApp Cloud API — Developer Console > WhatsApp > API Setup
# Single provider line per environment. Only the active Tenant whose technical
# phone identifier matches WHATSAPP_PHONE_NUMBER_ID can use it (HN-04).
# A business contact phone or a stored Channel does not connect another line.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Secret (Meta) — validación HMAC del webhook POST (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Reactivación HN-06: mapa por tenantId con name, languageCode y body EXACTOS
# de una plantilla aprobada en su WABA. Body-only, sin cabecera/botones;
# {{1}} = cliente y {{2}} = establecimiento (una aparición de cada variable).
# Vacío = no habilitado. Las antiguas variables globales NAME/LANG ya no bastan.
# Ejemplo sintético y procedimiento: docs/architecture/whatsapp-business-identity-hn06-20261029.md
WHATSAPP_REACTIVATION_TEMPLATES_JSON=

# Puerto del servidor Express (default: 3000)
PORT=3000

# Compatibilidad del administrador heredado: tenant usado como fallback.
# Las sesiones Staff conservan su tenant autenticado y se validan normalmente.
# No omite INTERNAL_API_SECRET ni la verificación de permisos por request.
SINGLE_TENANT_ID=

# Secreto compartido para rutas internas (X-Internal-Token) — debe coincidir
# EXACTAMENTE con INTERNAL_API_SECRET en frontend/.env.local
INTERNAL_API_SECRET=

# Entorno y observabilidad
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=

# Google Calendar — Service Account (compartir calendario con el email de la SA)
# GOOGLE_PRIVATE_KEY: pegar la clave con saltos de línea como \n
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Stripe — pagos por suscripción SaaS
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs: Dashboard > Products > crear plan mensual
# Solo servidor: el navegador envía planId (basic/pro), no identificadores Stripe.
# Deben ser distintos; dejar vacío deshabilita la contratación de ese plan.
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
# URL del frontend (para redireccionamiento Stripe en onboarding)
FRONTEND_URL=http://localhost:3001

# Canal privado para los empleados operativos. Deshabilitado hasta validar localmente.
OPERATOR_WHATSAPP_ENABLED=false
# Misma clave de servicio aleatoria (mínimo 32 bytes) en backend y frontend.
OPERATOR_CHANNEL_HMAC_KEY=
OPERATOR_CHANNEL_KEY_VERSION=v1

# Alta comercial por establecimiento. Mantener deshabilitada hasta la aceptación
# externa de Meta. La clave AES es exclusiva del servidor, base64 de 32 bytes.
WHATSAPP_MULTITENANT_ENABLED=false
WHATSAPP_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
PROVIDER_CREDENTIAL_KEY=
# Cupos de IA: unidades internas, no pesos ni tokens. Sin política o cupo no
# se permiten consumos con el control habilitado. Cupos provisionales, sin activar.
AI_QUOTA_ENABLED=false
AI_QUOTA_POLICY_VERSION=
# JSON con analyze, reply, embedding, transcription e interpret: pesos positivos.
# Texto: peso por bloque de 4.000 bytes; audio: peso por minuto iniciado (propuesta: 5).
# Embedding: peso por llamada. Audio: máximo 10 minutos y 20 MiB, medido localmente.
# La huella de pesos/medidor impide revalorar un mes abierto sin transición explícita.
AI_OPERATION_UNITS_JSON=
# URL fija privada del servidor Next; nunca una URL enviada por el usuario.
OPERATOR_AUTHORITY_URL=http://frontend:3001/api/internal/operator-authority

# Recordatorios se envían automáticamente a las 9AM (America/Bogota)
# Incluye: citas del día siguiente, vacunas por vencer (15 días) y grooming (30+ días)
# Requiere WHATSAPP_PHONE_NUMBER_ID y WHATSAPP_ACCESS_TOKEN

# Opcional — entorno Node
# NODE_ENV=development
