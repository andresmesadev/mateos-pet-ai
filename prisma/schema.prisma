model OperatorAuthority {
  id                   String @id @default(uuid())
  issuer               String @unique @db.VarChar(64)
  bootId               String @db.Uuid
  epoch                BigInt
  credentialEpoch      BigInt @default(1)
  principalKey         String @db.VarChar(256)
  credentialGeneration String @db.Char(64)
  keyVersion           String @db.VarChar(32)
  state                String @db.VarChar(16)
  registeredAt         DateTime @db.Timestamptz(3)
  updatedAt            DateTime @db.Timestamptz(3)
  subjects             OperatorSubject[]
  proofs               OperatorProof[]
}

model OperatorProof {
  id              String @id @default(uuid())
  issuer          String @db.VarChar(64)
  kind            String @db.VarChar(24)
  purpose         String @db.VarChar(32)
  tenantId        String?
  principalKey    String? @db.VarChar(256)
  authorityId     String?
  authorityEpoch  BigInt?
  credentialEpoch BigInt?
  generationHash  String? @db.Char(64)
  operationId     String @db.Uuid
  nonceDigest     String? @db.Char(64)
  keyVersion      String @db.VarChar(32)
  bindingHash     String @db.Char(64)
  issuedAt        DateTime @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)
  consumedAt      DateTime? @db.Timestamptz(3)
  result          Json?
  digestErasedAt  DateTime? @db.Timestamptz(3)
  tenant          Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authority       OperatorAuthority? @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  starts          OperatorLinkChallenge[] @relation("ChallengeStartProof")
  activations     OperatorLinkChallenge[] @relation("ChallengeActivationProof")
  windows         OperatorAuthorization[]
  @@unique([issuer, kind, operationId], map: "OPF_operation_key")
  @@unique([issuer, kind, nonceDigest], map: "OPF_nonce_key")
  @@index([expiresAt, id], map: "OPF_expiry_idx")
}

model OperatorSubject {
  id               String @id @default(uuid())
  tenantId         String
  principalKey     String @db.VarChar(256)
  kind             String @db.VarChar(16)
  staffSourceId    String?
  authorityId      String?
  credentialEpoch  BigInt @default(1)
  permissionEpoch  BigInt @default(1)
  state            String @db.VarChar(16)
  createdAt        DateTime @db.Timestamptz(3)
  updatedAt        DateTime @db.Timestamptz(3)
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authority        OperatorAuthority? @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  challenges       OperatorLinkChallenge[]
  links            OperatorLink[]
  work             OperatorInboundWork[]
  reviews          OperatorReview[]
  @@unique([tenantId, principalKey], map: "OS_principal_key")
  @@unique([tenantId, principalKey, id], map: "OS_scope_key")
  @@unique([tenantId, staffSourceId], map: "OS_staff_source_key")
}

model OperatorChannelRoute {
  id             String @id @default(uuid())
  tenantId       String
  channelId      String
  provider       String @db.VarChar(16)
  receiver       String @db.VarChar(64)
  version        BigInt @default(1)
  configHash     String @db.Char(64)
  state          String @default("disabled") @db.VarChar(16)
  createdAt      DateTime @db.Timestamptz(3)
  updatedAt      DateTime @db.Timestamptz(3)
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channel        Channel @relation(fields: [channelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  challenges     OperatorLinkChallenge[]
  links          OperatorLink[]
  participants   OperatorParticipant[]
  threads        OperatorThread[]
  deliveries     OperatorDelivery[]
  @@unique([tenantId, id], map: "OCR_scope_key")
  @@index([provider, receiver, state], map: "OCR_receiver_idx")
}

model OperatorLinkChallenge {
  id                 String @id @default(uuid())
  tenantId           String
  principalKey       String @db.VarChar(256)
  subjectId          String
  routeId            String
  routeVersion       BigInt
  phone              String @db.VarChar(16)
  credentialEpoch    BigInt
  adminGeneration    String? @db.Char(64)
  codeDigest         String? @db.Char(64)
  keyVersion         String @db.VarChar(32)
  startProofId       String @unique(map: "OLC_start_proof_key")
  activationProofId  String? @unique(map: "OLC_activation_proof_key")
  phoneProofJobId    String? @unique(map: "OLC_phone_proof_key")
  replacesLinkId     String?
  state              String @db.VarChar(24)
  failedAttempts     Int @default(0)
  createdAt          DateTime @db.Timestamptz(3)
  expiresAt          DateTime @db.Timestamptz(3)
  provedAt           DateTime? @db.Timestamptz(3)
  finishedAt         DateTime? @db.Timestamptz(3)
  digestErasedAt     DateTime? @db.Timestamptz(3)
  subject            OperatorSubject @relation(fields: [tenantId, principalKey, subjectId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  route              OperatorChannelRoute @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  startProof         OperatorProof @relation("ChallengeStartProof", fields: [startProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activationProof    OperatorProof? @relation("ChallengeActivationProof", fields: [activationProofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  phoneProof         InboundJob? @relation("ChallengePhoneProof", fields: [phoneProofJobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacesLink       OperatorLink? @relation("ChallengeReplacement", fields: [tenantId, principalKey, replacesLinkId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  producedLinks      OperatorLink[] @relation("LinkChallenge")
  @@unique([tenantId, principalKey, id], map: "OLC_scope_key")
  @@index([tenantId, principalKey, createdAt], map: "OLC_rate_idx")
  @@index([state, expiresAt, id], map: "OLC_expiry_idx")
}

model OperatorLink {
  id                   String @id @default(uuid())
  tenantId             String
  principalKey         String @db.VarChar(256)
  subjectId            String
  routeId              String
  phone                String @db.VarChar(16)
  challengeId          String @unique(map: "OL_challenge_key")
  credentialEpoch      BigInt
  adminGeneration      String? @db.Char(64)
  state                String @db.VarChar(16)
  version              BigInt @default(1)
  currentAuthorizationId String?
  createdAt            DateTime @db.Timestamptz(3)
  closedAt             DateTime? @db.Timestamptz(3)
  closeReason          String? @db.VarChar(64)
  subject              OperatorSubject @relation(fields: [tenantId, principalKey, subjectId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  route                OperatorChannelRoute @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  challenge            OperatorLinkChallenge @relation("LinkChallenge", fields: [tenantId, principalKey, challengeId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  replacementChallenges OperatorLinkChallenge[] @relation("ChallengeReplacement")
  authorizations       OperatorAuthorization[] @relation("LinkAuthorizations")
  currentAuthorization OperatorAuthorization? @relation("CurrentAuthorization", fields: [tenantId, principalKey, id, currentAuthorizationId], references: [tenantId, principalKey, linkId, id], onDelete: Restrict, onUpdate: Restrict, map: "OL_current_auth_fk")
  threads              OperatorThread[]
  sessions             OperatorSession[]
  @@unique([tenantId, principalKey, id], map: "OL_scope_key")
  @@index([tenantId, principalKey, createdAt, id], map: "OL_owner_idx")
}

model OperatorAuthorization {
  id                String @id @default(uuid())
  tenantId          String
  principalKey      String @db.VarChar(256)
  linkId            String
  number            BigInt
  proofId           String @unique(map: "OAZ_proof_key")
  credentialEpoch   BigInt
  adminGeneration   String? @db.Char(64)
  routeVersion      BigInt
  issuedAt          DateTime @db.Timestamptz(3)
  expiresAt         DateTime @db.Timestamptz(3)
  link              OperatorLink @relation("LinkAuthorizations", fields: [tenantId, principalKey, linkId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  proof             OperatorProof @relation(fields: [proofId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor        OperatorLink[] @relation("CurrentAuthorization")
  sessions          OperatorSession[]
  @@unique([tenantId, principalKey, linkId, number], map: "OAZ_number_key")
  @@unique([tenantId, principalKey, linkId, id], map: "OAZ_link_scope_key")
}

model OperatorParticipant {
  id                String @id @default(uuid())
  tenantId          String
  routeId           String
  phone             String @db.VarChar(16)
  mode              String @default("customer") @db.VarChar(16)
  modeVersion       BigInt @default(0)
  admittedOrdinal   BigInt @default(0)
  resolvedOrdinal   BigInt @default(0)
  currentSessionId  String?
  blockedReason     String? @db.VarChar(64)
  updatedAt         DateTime @db.Timestamptz(3)
  route             OperatorChannelRoute @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sessions          OperatorSession[] @relation("ParticipantSessions")
  currentSession    OperatorSession? @relation("CurrentOperatorSession", fields: [tenantId, id, currentSessionId], references: [tenantId, participantId, id], onDelete: Restrict, onUpdate: Restrict, map: "OPT_current_session_fk")
  jobs              InboundJob[]
  deliveries        OperatorDelivery[]
  @@unique([tenantId, routeId, phone], map: "OPT_address_key")
  @@unique([tenantId, routeId, id], map: "OPT_route_scope_key")
  @@unique([tenantId, id], map: "OPT_scope_key")
}

model OperatorThread {
  id                String @id @default(uuid())
  tenantId          String
  principalKey      String @db.VarChar(256)
  linkId            String @unique(map: "OTH_link_key")
  routeId           String
  state             String @db.VarChar(16)
  version           BigInt @default(1)
  selectedEmployeeId String?
  selectedActionId  String?
  taskContext       Json?
  createdAt         DateTime @db.Timestamptz(3)
  closedAt          DateTime? @db.Timestamptz(3)
  link              OperatorLink @relation(fields: [tenantId, principalKey, linkId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  route             OperatorChannelRoute @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedEmployee  DigitalEmployee? @relation(fields: [tenantId, selectedEmployeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedAction    OperationalAction? @relation(fields: [tenantId, principalKey, selectedActionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  sessions          OperatorSession[]
  messages          OperatorMessage[]
  @@unique([tenantId, principalKey, id], map: "OTH_scope_key")
}

model OperatorSession {
  id                String @id @default(uuid())
  tenantId          String
  principalKey      String @db.VarChar(256)
  linkId            String
  authorizationId   String
  participantId     String
  threadId          String
  credentialEpoch   BigInt
  routeVersion      BigInt
  modeVersion       BigInt
  openedOrdinal     BigInt
  lastActivityOrdinal BigInt
  state             String @db.VarChar(16)
  openedAt          DateTime @db.Timestamptz(3)
  lastActivityAt    DateTime @db.Timestamptz(3)
  idleExpiresAt     DateTime @db.Timestamptz(3)
  absoluteExpiresAt DateTime @db.Timestamptz(3)
  closedAt          DateTime? @db.Timestamptz(3)
  closeReason       String? @db.VarChar(64)
  link              OperatorLink @relation(fields: [tenantId, principalKey, linkId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  authorization     OperatorAuthorization @relation(fields: [tenantId, principalKey, linkId, authorizationId], references: [tenantId, principalKey, linkId, id], onDelete: Restrict, onUpdate: Restrict)
  participant       OperatorParticipant @relation("ParticipantSessions", fields: [tenantId, participantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor        OperatorParticipant[] @relation("CurrentOperatorSession")
  thread            OperatorThread @relation(fields: [tenantId, principalKey, threadId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  messages          OperatorMessage[]
  work              OperatorInboundWork[]
  reviews           OperatorReview[]
  interactions      OperatorInteraction[]
  deliveries        OperatorDelivery[]
  jobs              InboundJob[] @relation("JobOperatorSession")
  @@unique([tenantId, principalKey, id], map: "OSS_scope_key")
  @@unique([tenantId, participantId, id], map: "OSS_participant_scope_key")
  @@index([state, idleExpiresAt, id], map: "OSS_expiry_idx")
}

model OperatorMessage {
  id                  String @id @default(uuid())
  tenantId            String
  principalKey        String @db.VarChar(256)
  threadId            String
  sessionId           String
  incomingJobId       String? @unique(map: "OM_incoming_key")
  direction           String @db.VarChar(8)
  actorKind           String @db.VarChar(16)
  actorName           String @db.VarChar(160)
  content             Json
  accessClass         String @db.VarChar(24)
  accessProjection    Json
  permissionEpoch     BigInt
  tenantAccessEpoch   BigInt
  createdAt           DateTime @db.Timestamptz(3)
  thread              OperatorThread @relation(fields: [tenantId, principalKey, threadId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  session             OperatorSession @relation(fields: [tenantId, principalKey, sessionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  incoming            InboundJob? @relation("OperatorIncomingMessage", fields: [incomingJobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviews             OperatorReview[]
  interactions        OperatorInteraction[]
  deliveries          OperatorDelivery[]
  @@unique([tenantId, principalKey, id], map: "OM_scope_key")
  @@index([tenantId, principalKey, threadId, createdAt, id], map: "OM_history_idx")
}

model OperatorInboundWork {
  id                  String @id @default(uuid())
  tenantId            String
  principalKey        String @db.VarChar(256)
  subjectId           String
  sessionId           String
  jobId               String
  stepKey             String @db.VarChar(64)
  kind                String @db.VarChar(24)
  inputHash           String @db.Char(64)
  requestKey          String? @db.Uuid
  operationalRequestId String?
  actionId            String?
  expectedRevision    Int?
  state               String @db.VarChar(16)
  result              Json?
  createdAt           DateTime @db.Timestamptz(3)
  resolvedAt          DateTime? @db.Timestamptz(3)
  subject             OperatorSubject @relation(fields: [tenantId, principalKey, subjectId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  session             OperatorSession @relation(fields: [tenantId, principalKey, sessionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  job                 InboundJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operationalRequest  OperationalRequest? @relation(fields: [operationalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  action              OperationalAction? @relation(fields: [tenantId, principalKey, actionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([jobId, stepKey], map: "OIW_step_key")
  @@unique([tenantId, principalKey, requestKey], map: "OIW_request_key")
  @@index([tenantId, principalKey, createdAt, id], map: "OIW_owner_idx")
}

model OperatorReview {
  id                String @id @default(uuid())
  tenantId          String
  principalKey      String @db.VarChar(256)
  subjectId         String
  kind              String @db.VarChar(8)
  actionId          String
  revision          Int
  basisId           String?
  sessionId         String?
  messageId         String?
  payloadHash       String @db.Char(64)
  previewHash       String @db.Char(64)
  permissionEpoch   BigInt
  tenantAccessEpoch BigInt
  createdAt         DateTime @db.Timestamptz(3)
  expiresAt         DateTime? @db.Timestamptz(3)
  subject           OperatorSubject @relation(fields: [tenantId, principalKey, subjectId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  actionRevision    ActionRevision @relation(fields: [tenantId, principalKey, actionId, revision], references: [tenantId, principalKey, actionId, number], onDelete: Restrict, onUpdate: Restrict)
  basis             OperatorReview? @relation("ReviewBasis", fields: [tenantId, principalKey, basisId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  displays          OperatorReview[] @relation("ReviewBasis")
  session           OperatorSession? @relation(fields: [tenantId, principalKey, sessionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  message           OperatorMessage? @relation(fields: [tenantId, principalKey, messageId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  interactions      OperatorInteraction[]
  @@unique([tenantId, principalKey, id], map: "ORV_scope_key")
}

model OperatorInteraction {
  id                String @id @default(uuid())
  tenantId          String
  principalKey      String @db.VarChar(256)
  sessionId         String
  messageId         String
  reviewId          String?
  kind              String @db.VarChar(24)
  actionId          String?
  expectedRevision  Int?
  productId         String?
  selectionContext  Json?
  tokenDigest       String @unique(map: "OI_token_key") @db.Char(64)
  keyVersion        String @db.VarChar(32)
  modeVersion       BigInt
  routeVersion      BigInt
  permissionEpoch   BigInt
  tenantAccessEpoch BigInt
  state             String @db.VarChar(16)
  expiresAt         DateTime @db.Timestamptz(3)
  offeredAt         DateTime? @db.Timestamptz(3)
  providerMessageId String?
  consumedAt        DateTime? @db.Timestamptz(3)
  receiptId         String?
  resultReference   Json?
  createdAt         DateTime @db.Timestamptz(3)
  session           OperatorSession @relation(fields: [tenantId, principalKey, sessionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  message           OperatorMessage @relation(fields: [tenantId, principalKey, messageId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  review            OperatorReview? @relation(fields: [tenantId, principalKey, reviewId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  action            OperationalAction? @relation(fields: [tenantId, principalKey, actionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  product           InventoryProduct? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  receipt           ExecutionReceipt? @relation(fields: [tenantId, principalKey, receiptId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([tenantId, principalKey, id], map: "OI_scope_key")
  @@index([state, expiresAt, id], map: "OI_expiry_idx")
}

model OperatorDelivery {
  id                 String @id @default(uuid())
  tenantId           String
  principalKey       String? @db.VarChar(256)
  routeId            String
  routeVersion       BigInt
  participantId      String
  sessionId          String?
  messageId          String? @unique(map: "OD_message_key")
  sourceJobId        String
  replyOrdinal       Int
  kind               String @db.VarChar(16)
  controlCode        String? @db.VarChar(40)
  modeVersion        BigInt
  permissionEpoch    BigInt?
  tenantAccessEpoch  BigInt?
  state              String @db.VarChar(16)
  claimGeneration    BigInt @default(0)
  claimOwner         String? @db.Uuid
  claimUntil         DateTime? @db.Timestamptz(3)
  attemptCount       Int @default(0)
  providerMessageId  String?
  acceptedAt         DateTime? @db.Timestamptz(3)
  blockedReason      String? @db.VarChar(64)
  lastErrorCode      String? @db.VarChar(64)
  createdAt          DateTime @db.Timestamptz(3)
  updatedAt          DateTime @db.Timestamptz(3)
  route              OperatorChannelRoute @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  participant        OperatorParticipant @relation(fields: [tenantId, routeId, participantId], references: [tenantId, routeId, id], onDelete: Restrict, onUpdate: Restrict)
  session            OperatorSession? @relation(fields: [tenantId, principalKey, sessionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  message            OperatorMessage? @relation(fields: [tenantId, principalKey, messageId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  source             InboundJob @relation(fields: [sourceJobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audit              OperatorAudit[]
  @@unique([sourceJobId, replyOrdinal], map: "OD_reply_key")
  @@unique([routeId, providerMessageId], map: "OD_provider_key")
  @@index([state, claimUntil, id], map: "OD_claim_idx")
  @@index([tenantId, principalKey, createdAt, id], map: "OD_owner_idx")
}

model OperatorAudit {
  id                String @id @default(uuid())
  tenantId          String?
  ownerPrincipalKey String? @db.VarChar(256)
  actorKind         String @db.VarChar(24)
  actorPrincipalKey String? @db.VarChar(256)
  eventCode         String @db.VarChar(48)
  causeKey          String @unique(map: "OAU_cause_key") @db.Char(64)
  deliveryId        String?
  attemptNumber     Int?
  evidence          Json
  createdAt         DateTime @db.Timestamptz(3)
  tenant            Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delivery          OperatorDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([tenantId, ownerPrincipalKey, createdAt, id], map: "OAU_owner_idx")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model InventoryProduct {
  selections OperatorInteraction[]
  id              String @id @default(cuid())
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name            String @db.VarChar(160)
  category        String @db.VarChar(80)
  internalCode    String @db.VarChar(64)
  internalCodeKey String @db.VarChar(64)
  barcode         String? @db.VarChar(80)
  presentation    String @db.VarChar(80)
  uses            String[]
  referenceCost   Decimal @db.Decimal(10, 2)
  salePrice       Decimal? @db.Decimal(10, 2)
  stockMinimum    Int @default(0)
  lotPolicy       String @db.VarChar(16)
  active          Boolean @default(true)
  removedAt       DateTime? @db.Timestamptz(3)
  metadataVersion Int @default(1)
  priceVersion    Int @default(1)
  stockRevision   Int @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  lots            InventoryLot[]
  items           TransactionItem[]
  operations      InventoryOperation[]

  @@unique([tenantId, id], map: "InventoryProduct_tenant_id_key")
  // Códigos únicos entre productos no retirados: índices parciales en SQL.
  @@index([tenantId, active, name], map: "InventoryProduct_catalog_idx")
}

model InventoryLot {
  id              String @id @default(cuid())
  tenantId        String
  productId       String
  product         InventoryProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  groupKind       String @db.VarChar(16)
  commercialCode  String? @db.VarChar(80)
  commercialKey   String? @db.VarChar(80)
  expiresOn       DateTime? @db.Date
  balancePhysical Int @default(0)
  firstReceivedAt DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  movements       InventoryMovement[]

  @@unique([tenantId, productId, id], map: "InventoryLot_identity_key")
  @@unique([tenantId, productId, commercialKey], map: "InventoryLot_commercial_key")
  // Un agrupador untracked por producto: índice PARCIAL en SQL, no en Prisma.
  @@index([tenantId, productId, expiresOn, firstReceivedAt, id], map: "InventoryLot_selection_idx")
}

model InventoryOperation {
  id                String @id @default(cuid())
  tenantId          String
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  principalKey      String @db.VarChar(256)
  kind              String @db.VarChar(40)
  requestKey        String @db.Uuid
  contractVersion   Int
  payloadHash       String @db.Char(64)
  actorId           String @db.VarChar(256)
  actorName         String @db.VarChar(160)
  actorRole         String @db.VarChar(32)
  confirmedAt       DateTime @db.Timestamptz(3)
  resultKind        String @db.VarChar(16)
  resultProductId   String?
  resultSaleId      String?
  sourceOperationId String?
  resultEvidence    Json?
  product           InventoryProduct? @relation(fields: [tenantId, resultProductId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sale              Transaction? @relation(fields: [tenantId, resultSaleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceOperation   InventoryOperation? @relation("InventoryCorrection", fields: [tenantId, sourceOperationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  corrections       InventoryOperation[] @relation("InventoryCorrection")
  movements         InventoryMovement[]
  returns           InventoryReturnLine[]

  @@unique([tenantId, id], map: "InventoryOperation_tenant_id_key")
  @@unique([tenantId, principalKey, kind, requestKey], map: "InventoryOperation_request_key")
  @@unique([tenantId, resultSaleId], map: "InventoryOperation_sale_key")
  @@index([tenantId, confirmedAt, id], map: "InventoryOperation_history_idx")
  operationalReceipts ExecutionReceipt[]
  @@unique([tenantId, principalKey, id], map: "IO_principal_id_key")
}

model InventoryMovement {
  id                       String @id @default(cuid())
  tenantId                 String
  operationId              String
  operation                InventoryOperation @relation(fields: [tenantId, operationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  productId                String
  lotId                    String
  lot                      InventoryLot @relation(fields: [tenantId, productId, lotId], references: [tenantId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  ordinal                  Int
  kind                     String @db.VarChar(32)
  quantity                 Int
  stockDelta               Int
  balanceBefore            Int
  balanceAfter             Int
  occurredAt               DateTime @db.Timestamptz(3)
  reason                   String? @db.VarChar(1000)
  actorId                  String @db.VarChar(256)
  actorName                String @db.VarChar(160)
  actorRole                String @db.VarChar(32)
  productNameSnapshot      String @db.VarChar(160)
  productCodeSnapshot      String @db.VarChar(64)
  presentationSnapshot     String @db.VarChar(80)
  lotCodeSnapshot          String? @db.VarChar(80)
  expiresOnSnapshot        DateTime? @db.Date
  entryUnitCost            Decimal? @db.Decimal(10, 2)
  transactionId            String?
  transactionItemId        String?
  saleItem                 TransactionItem? @relation(fields: [tenantId, transactionId, transactionItemId, productId], references: [tenantId, transactionId, id, productId], onDelete: Restrict, onUpdate: Restrict)
  area                     String? @db.VarChar(16)
  appointmentId            String?
  appointment              Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceMovementId         String?
  sourceMovement           InventoryMovement? @relation("InventoryCompensation", fields: [tenantId, sourceMovementId, productId, lotId], references: [tenantId, id, productId, lotId], onDelete: Restrict, onUpdate: Restrict)
  compensations            InventoryMovement[] @relation("InventoryCompensation")
  returnLineId             String?
  returnLine               InventoryReturnLine? @relation(fields: [tenantId, returnLineId, transactionId, transactionItemId, productId], references: [tenantId, id, transactionId, transactionItemId, productId], onDelete: Restrict, onUpdate: Restrict)
  countedQuantity          Int?
  expectedStockRevision    Int?

  @@unique([tenantId, id, productId, lotId], map: "InventoryMovement_source_key")
  @@unique([tenantId, operationId, ordinal], map: "InventoryMovement_ordinal_key")
  @@index([tenantId, productId, occurredAt, id], map: "InventoryMovement_product_history_idx")
  @@index([tenantId, sourceMovementId], map: "InventoryMovement_compensation_idx")
  @@index([tenantId, transactionItemId], map: "InventoryMovement_sale_item_idx")
  @@index([tenantId, returnLineId], map: "InventoryMovement_return_idx")
}

model InventoryReturnLine {
  id                String @id @default(cuid())
  tenantId          String
  operationId       String
  operation         InventoryOperation @relation(fields: [tenantId, operationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  transactionId     String
  transactionItemId String @unique(map: "InventoryReturnLine_once_key")
  productId         String
  saleItem          TransactionItem @relation(fields: [tenantId, transactionId, transactionItemId, productId], references: [tenantId, transactionId, id, productId], onDelete: Restrict, onUpdate: Restrict)
  quantity          Int
  disposition       String @db.VarChar(16)
  reason            String @db.VarChar(1000)
  recordedAt        DateTime @db.Timestamptz(3)
  movements         InventoryMovement[]

  @@unique([tenantId, id, transactionId, transactionItemId, productId], map: "InventoryReturnLine_identity_key")
  @@unique([tenantId, transactionId, transactionItemId, productId], map: "InventoryReturnLine_item_identity_key")
  @@index([tenantId, transactionId], map: "InventoryReturnLine_sale_idx")
}

model Tenant {
  operatorAccessEpoch BigInt @default(1) // Only new scalar on this projection.
  proofs              OperatorProof[]
  subjects            OperatorSubject[]
  operatorRoutes      OperatorChannelRoute[]
  operatorAudit       OperatorAudit[]
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?  @unique // Identificador técnico del canal, ausente hasta conectar WhatsApp.
  email     String?
  plan      String   @default("free")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   // active / past_due / canceled / trialing
  planExpiresAt        DateTime?

  // Perfil del negocio (TAREA 18)
  contactPhone  String? @db.VarChar(16) // Contacto editable; phone identifica el canal de WhatsApp.
  description   String?
  address       String?
  logoUrl       String?
  businessHours Json?   // { mon: { open: "08:00", close: "18:00", active: true }, ... }

  // Entregable 4.3 — Configuración por Establecimiento (Alcance A): fuente
  // real que reemplaza los dos PrismaBusinessConfigReader hardcodeados de
  // Services y Staff. Sin relación con el motor conversacional.
  activeModules       String[] @default(["grooming", "veterinary"])
  commissionSplitRate Decimal  @default(0.5) @db.Decimal(4, 3)

  users         User[]
  pets          Pet[]
  appointments  Appointment[]
  conversations Conversation[]
  services      Service[]
  groomingTransportZones GroomingTransportZone[]
  serviceCategories ServiceCategory[]
  staff         Staff[]
  nextActions   PetNextAction[]
  transactions  Transaction[]
  inventoryProducts InventoryProduct[]
  inventoryOperations InventoryOperation[]
  expenses      Expense[]
  commissions   Commission[]
  settlements   Settlement[]
  dailyCloses      DailyClose[]
  cashOpenings     CashOpening[]
  financialPeriods FinancialPeriod[]
  domainEvents     DomainEvent[]
  channels         Channel[]
  digitalEmployees DigitalEmployee[]
  automationRules  AutomationRule[]
  apiKeys          ApiKey[]
  clientVerificationCodes ClientVerificationCode[]
  clientSessions          ClientSession[]
  knowledgeChunks         KnowledgeChunk[]
  agendaExceptions       AgendaException[]
  operationalRequests OperationalRequest[]
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name      String
  role      String   // "vet" | "groomer" | "receptionist" | "admin"
  accessPermissions String[] @default([]) // "cash" | "appointment_price" | "inventory_consume"
  serviceScope String @default("auto") // "auto" (legado) | "role" | "selected"
  phone     String?
  email     String?
  active    Boolean  @default(true)
  // Disponibilidad semanal (legado, Fase 1 — ver ADR 003): { mon: { open: "08:00", close: "18:00", active: true }, ... }
  // El editor sincroniza las franjas semanales con StaffAvailability bajo lock (ADRs 011/018).
  availability Json?
  generatesCommission Boolean @default(true)
  contractType String?
  commissionRate Decimal? @db.Decimal(5, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  commissions    Commission[]
  performedSaleItems TransactionItem[]
  availabilities StaffAvailability[]
  capabilities   StaffCapability[]
  settlements    Settlement[]
  escalations    Escalation[]
  credential     StaffCredential?
  authoredMedicalRecords MedicalRecord[] @relation("MedicalRecordAuthor")
  editedMedicalRecords   MedicalRecord[] @relation("MedicalRecordEditor")
}

// Acceso individual del profesional al dashboard clínico. La cuenta se
// desactiva también cuando Staff.active pasa a false.
model StaffCredential {
  staffId      String   @id
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  sessionVersion Int     @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StaffAvailability {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])

  type      String   // "base_schedule" | "planned_absence" | "unplanned_absence"

  weekday   Int?      // 0-6 — solo type = "base_schedule"
  startTime String?   // "HH:mm" — solo type = "base_schedule"
  endTime   String?   // "HH:mm" — solo type = "base_schedule"

  startAt   DateTime? // solo ausencias (programada o imprevista)
  endAt     DateTime? // solo ausencias
  reason    String?   // solo ausencias

  voidedAt   DateTime?
  voidReason String?
  voidedBy   String?
  replacesId String? @unique
  replaces   StaffAvailability? @relation("AvailabilityCorrection", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement StaffAvailability? @relation("AvailabilityCorrection")

  createdAt DateTime @default(now())

  @@index([staffId, type])
  @@index([staffId, weekday])
  @@index([staffId, startAt, endAt])
}

model StaffCapability {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])

  serviceId String   // referencia a Service — deliberadamente sin clave foránea real

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([staffId, active])
  @@index([serviceId, active])
}

model Settlement {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal  @db.Decimal(10, 2)

  status      String   @default("active") // "active" | "voided"
  voidedAt    DateTime?
  voidReason  String?

  replacesSettlementId String?
  replacesSettlement   Settlement?  @relation("SettlementReplacement", fields: [replacesSettlementId], references: [id])
  replacedBy           Settlement[] @relation("SettlementReplacement")

  createdAt   DateTime @default(now())

  @@index([staffId, status])
  @@index([tenantId, staffId, periodStart])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  duration    Int?     // minutos; nullable para complementos sin reserva
  basePrice   Decimal? @db.Decimal(10, 2)
  requiresAppointment Boolean @default(true)
  appliesCommissionSplit Boolean?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  priceRules   PriceRule[]
  saleItems TransactionItem[]
  saleCommissions Commission[]

  @@index([tenantId, categoryId])
  @@index([tenantId, active])
}

model ServiceCategory {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  name      String
  appliesCommissionSplit Boolean @default(false)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())

  services  Service[]

  @@unique([tenantId, name])
}

model PriceRule {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  targetType String   // "breed" | "size" | "client" | "pet"
  targetId   String   // id de raza/cliente/mascota, o valor literal si targetType = "size"

  price      Decimal  @db.Decimal(10, 2)
  active     Boolean  @default(true)

  createdAt  DateTime @default(now())

  @@index([serviceId, active])
}

model User {
  id        String   @id @default(cuid())
  phone     String
  phoneAlt  String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name      String?
  email     String?
  address   String?
  neighborhood String?
  notes              String?
  lastReminderSentAt DateTime?
  createdAt          DateTime @default(now())

  pets              Pet[]
  conversations     Conversation[]
  appointments      Appointment[]
  memoryEmbeddings  MemoryEmbedding[]
  transactions      Transaction[]

  // listClients (orderBy createdAt) y recovery (filtro lastReminderSentAt)
  @@index([tenantId, createdAt])
  @@index([tenantId, lastReminderSentAt])
  // Entregable 4.1 — saneamiento tenant-blind (M1): la unicidad de teléfono
  // deja de ser global y pasa a ser por tenant (dos establecimientos
  // distintos pueden tener cada uno un cliente con el mismo número).
  @@unique([tenantId, phone])

  clientVerificationCodes ClientVerificationCode[]
  clientSessions          ClientSession[]
}

model Pet {
  id        String   @id @default(cuid())
  name      String
  type      String
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  ownerId   String
  owner     User @relation(fields: [ownerId], references: [id])

  breed      String?
  gender     String?
  birthDate  DateTime?
  weight     Float?
  sterilized            Boolean?
  notes                 String?
  operationalAlerts     String? // Shared handling alerts; legacy clinical/free-form notes stay private
  defaultGroomingPrice  Decimal? @db.Decimal(10, 2)
  defaultGroomingWithTransportPrice Decimal? @db.Decimal(10, 2)
  defaultGroomingTransportPrice Decimal? @db.Decimal(10, 2)
  defaultGroomingTransportMode String?

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  nextActions    PetNextAction[]
  transactions   Transaction[]

  groomingReminderSent Boolean @default(false)

  createdAt DateTime @default(now())

  // listPets (filtro tenantId, orderBy createdAt) y joins por dueño
  @@index([tenantId, createdAt])
  @@index([ownerId])
}

// status: "pending" | "done" | "dismissed"
// type:   "control" | "vaccine" | "grooming" | "exam" | "treatment" | "other"
model PetNextAction {
  id       String  @id @default(cuid())
  petId    String
  pet      Pet     @relation(fields: [petId], references: [id])
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  type   String
  notes  String?
  dueAt  DateTime
  status String   @default("pending")

  // Trazabilidad — qué generó esta acción
  sourceRecordId      String?
  sourceAppointmentId String?

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // opportunities/summary (tenantId + status, orderBy dueAt) y listNextActions por pet
  @@index([tenantId, status, dueAt])
  @@index([petId, status])
}

model MedicalRecord {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])

  // Link to the originating appointment (TAREA 10)
  appointmentId String?   @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // Attending professional
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])
  createdByStaffId String?
  createdByStaff   Staff? @relation("MedicalRecordAuthor", fields: [createdByStaffId], references: [id])
  updatedByStaffId String?
  updatedByStaff   Staff? @relation("MedicalRecordEditor", fields: [updatedByStaffId], references: [id])

  type      String
  title     String
  detail    String?
  date      DateTime?

  // Clinical fields (TAREA 10) — all optional for backward compatibility
  reason          String?
  findings        String?
  diagnosis       String?
  treatment       String?
  recommendations String?
  weight          Float?
  nextControlAt   DateTime?

  reminderSent Boolean @default(false)
  version Int @default(1)
  revisions MedicalRecordRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // timeline/records por mascota (standaloneRecords where petId)
  @@index([petId])
  // churn/inactivos/reactivar filtran por type="grooming" + date
  @@index([petId, type])
  @@index([type, date])
  @@index([createdByStaffId])
  @@index([updatedByStaffId])
  // opportunities: nextControlAt con ventana de fechas
  @@index([nextControlAt])
}

model MedicalRecordRevision {
  id String @id @default(cuid())
  recordId String
  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  version Int
  before Json
  after Json
  reason String
  actorType String
  actorStaffId String?
  actorName String
  actorEmail String?
  createdAt DateTime @default(now())

  @@unique([recordId, version])
  @@index([recordId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  intent      String?
  step        String?
  /// Estado del wizard de reserva (pet_name, scheduling_date_key, etc.)
  sessionData Json?

  // Entregable 3.1 — Comunicación: reemplaza sessionData.requires_human_attention.
  status    String   @default("activa") // "activa" | "esperando_humano" | "cerrada"
  assignedActorId   String?
  assignedActorName String?
  assignedActorRole String?
  assignedAt       DateTime?
  controlChangedAt DateTime?
  controlVersion   Int @default(0)
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  // Mejora post-Fase 8 (2026-09-08): abandoned-conversation.job.js — evita
  // reenviar el recordatorio de wizard abandonado más de una vez por
  // abandono. Se resetea a false en cada syncConversationState que escribe
  // `step` (conversation-persistence.service.js) — cualquier turno nuevo
  // invalida el abandono anterior.
  abandonReminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages          Message[]
  memoryEmbeddings  MemoryEmbedding[]

  // listConversations (tenantId, orderBy updatedAt) y lookup por usuario
  @@index([tenantId, updatedAt])
  @@index([userId])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  role            String
  content         String

  // Entregable 3.1 — Comunicación: aditivo, no reemplaza role.
  // "cliente" | "agente" | "sistema" — distingue por primera vez una
  // notificación proactiva de una respuesta conversacional.
  origin          String   @default("cliente")
  // Snapshot autenticado. Nulos: historial anterior sin autoría verificable.
  senderKind      String?  // "human" | "ai" | "system"
  senderActorId   String?
  senderName      String?
  senderRole      String?

  // Entregable 8.1 (D-E4) — el `wamid` de Meta (message.id) para mensajes
  // entrantes de WhatsApp. Nulo para mensajes salientes/de sistema y para
  // cualquier fila anterior a este entregable. Único: si Meta reintenta la
  // entrega de un webhook por timeout, el segundo intento se detecta antes
  // de reprocesar (ver findMessageByExternalId, conversation-persistence).
  externalId      String?  @unique

  createdAt       DateTime @default(now())

  memoryEmbeddings MemoryEmbedding[]

  // getConversationMessages (where conversationId)
  @@index([conversationId])
}

// ── Comunicación (Entregable 3.1, Fase 3) ──────────────────────────────────
// Diseño congelado: docs/architecture/technical-design/comunicacion-esquema-fisico.md
// Canal es tenant-scoped (a diferencia de EventType, catálogo global): un
// Canal describe una línea propia del negocio (WhatsApp, Email...). tenantId
// nulo = canal global/compartido (estado actual: una sola línea).
model Channel {
  operatorRoutes OperatorChannelRoute[]
  id       String   @id @default(cuid())
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  type   String  // "whatsapp" | "email" | "sms" — tipo de canal, no proveedor
  active Boolean @default(true)

  createdAt DateTime @default(now())

  conversations Conversation[]

  @@unique([tenantId, type])
}

/// Embeddings semánticos (pgvector). Dimensión 1536 = text-embedding-3-small / similar.
model MemoryEmbedding {
  id             String   @id @default(cuid())

  userId         String
  user           User @relation(fields: [userId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  messageId      String?
  message        Message? @relation(fields: [messageId], references: [id])

  content        String
  embedding      Unsupported("vector(1536)")

  metadata       Json?

  createdAt      DateTime @default(now())
}

/// Base de conocimiento del negocio (motor conversacional): fragmentos de
/// notas del Establecimiento (ej. exportadas de Obsidian), con su embedding
/// (pgvector), acotados por tenantId — a diferencia de MemoryEmbedding
/// (memoria por cliente), esto es conocimiento compartido por todo el
/// tenant. Se ingesta vía scripts/ingest-knowledge.js.
model KnowledgeChunk {
  id        String   @id @default(cuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  source    String?
  content   String
  embedding Unsupported("vector(1536)")
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Appointment {
  inventoryMovements InventoryMovement[]
  @@unique([tenantId, id], map: "Appointment_inventory_tenant_id_key")
  id          String   @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  petId       String?
  pet         Pet? @relation(fields: [petId], references: [id])

  petName     String
  petType     String

  serviceType String

  // Entregable 4.1 — saneamiento tenant-blind (A6): unidad real de reserva
  // (bucket de tipo de servicio: "vet" | "grooming"), derivada de serviceType
  // en escritura. Junto con tenantId + date forma la restricción única
  // parcial que reemplaza la verificación de conflicto no atómica existente.
  availabilityBucket String?

  // Operational fields (TAREA 9)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id])
  finalPrice  Decimal? @db.Decimal(10, 2)
  priceActorId String?
  priceActorName String?
  priceActorRole String?
  startedAt   DateTime?
  endedAt     DateTime?

  date        DateTime
  // status: pending | confirmed | arrived | in_progress | completed | no_show | cancelled
  status      String   @default("pending")

  googleEventId String?

  address       String?
  groomingBreed String?
  groomingSize  String?

  // Notas operativas por visita; independientes del expediente clínico.
  groomingNotes          String?
  groomingNotesVersion   Int       @default(1)
  groomingNotesUpdatedAt DateTime?
  groomingDeliveredAt   DateTime?

  transportMode       String   @default("none")
  transportPrice      Decimal? @db.Decimal(10, 2)
  transportPriceSource String?
  transportZoneId     String?
  transportZoneName   String?
  transportAddress    String?
  transportNeighborhood String?
  transportScope      String?
  transportSharedWithId String?
  transportSharedWith Appointment? @relation("SharedGroomingTransport", fields: [tenantId, transportSharedWithId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "Appointment_transport_shared_tenant_fkey")
  transportCoveredAppointments Appointment[] @relation("SharedGroomingTransport")

  reminderSent  Boolean  @default(false)
  followUpSent  Boolean  @default(false)

  medicalRecord MedicalRecord?
  transactions  Transaction[] // Entregable 2.3 (ADR 005): puede haber más de una, una por origen — ver Transaction.origin
  commissions   Commission[]  // Entregable Puente (ADR 009): una activa por cita; las anuladas quedan para trazabilidad

  createdAt   DateTime @default(now())

  // today/upcoming/week (tenantId + rango de date), métricas por status,
  // recovery/churn (userId + date), y timeline por mascota (petId)
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([userId, date])
  @@index([petId])
  @@index([tenantId, transportSharedWithId])
  @@index([tenantId, petId, date])
}

// Technical MVCC guard; serializes booking identity changes per tenant/pet.
model AppointmentBookingGuard {
  tenantId String
  petId String
  revision BigInt @default(0)
  @@id([tenantId, petId])
}

// Independent immutable audit: the erroneous reservation itself is removed.
model AppointmentRemoval {
  id String @id @default(cuid())
  appointmentId String @unique
  tenantId String
  actorId String
  actorName String
  actorRole String
  reason String
  previousStatus String
  snapshot Json
  removedAt DateTime @default(now())
  @@index([tenantId, removedAt])
}

model GroomingTransportZone {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name          String
  roundTripPrice Decimal? @db.Decimal(10, 2)
  pickupPrice   Decimal? @db.Decimal(10, 2)
  deliveryPrice Decimal? @db.Decimal(10, 2)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

// Excepciones fechadas de disponibilidad del establecimiento (ADR 013).
// `startDate`/`endDate` se guardan como claves civiles YYYY-MM-DD de Bogotá,
// no como DateTime, para que nunca se desplacen por conversión UTC.
model AgendaException {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  scope     String   // "all" | "vet" | "grooming"
  mode      String   // "closed" | "open"
  startDate String   @db.VarChar(10)
  endDate   String?  @db.VarChar(10)
  open      String?  @db.VarChar(5)
  close     String?  @db.VarChar(5)
  reason    String?  @db.VarChar(240)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startDate, endDate])
  @@index([tenantId, scope, startDate, endDate])
}

// ── POS / Facturación (TAREA 17) ──────────────────────────────
// paymentMethod: "cash" | "transfer" | "card" | "other"
model Transaction {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  petId         String?
  pet           Pet?     @relation(fields: [petId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  total         Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("cash")
  recordedActorId String?
  recordedActorName String?
  recordedActorRole String?
  notes         String?
  paidAt        DateTime? @default(now()) // null: appointment charge pending human payment confirmation
  createdAt     DateTime @default(now())

  // "manual_pos_sale" | "system_appointment_completed" — Entregable 2.3, ADR 005.
  // Transaction es una única entidad (el ingreso del negocio); origin determina qué
  // subconjunto de invariantes aplica a cada fila, igual que StaffAvailability.type.
  origin        String   @default("manual_pos_sale")

  // Entregable Puente — patrón completo de anulación (ADR 009, homogéneo con Commission).
  // Forma parte del modelo general para ambos orígenes; que solo exista comando de
  // anulación para manual_pos_sale es una decisión de alcance, no del modelo.
  status        String   @default("active") // "active" | "voided"
  voidedAt      DateTime?
  voidReason    String?
  replacesTransactionId String?
  replacesTransaction   Transaction?  @relation("TransactionReplacement", fields: [replacesTransactionId], references: [id])
  replacedBy            Transaction[] @relation("TransactionReplacement")

  items         TransactionItem[]
  inventoryItems TransactionItem[] @relation("InventoryItemParent")
  inventoryOperations InventoryOperation[]
  @@unique([tenantId, id], map: "Transaction_inventory_tenant_id_key")

  // listTransactions y /metrics/revenue (tenantId + rango de paidAt)
  @@index([tenantId, paidAt])
  // La unicidad real es parcial — como máximo una Transaction ACTIVA por (cita, origen) —
  // y vive como índice único parcial en SQL (WHERE status = 'active'), que Prisma no
  // expresa en el schema. Ver la migración del Entregable Puente. Este índice cubre
  // las búsquedas del reactivo y del POS.
  @@index([appointmentId, origin])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  description   String
  serviceId String?
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  performedByStaffId String?
  performedByStaff Staff? @relation(fields: [performedByStaffId], references: [id], onDelete: Restrict)
  commissions Commission[]
  appointmentComponent String? @db.VarChar(16)
  itemKind      String @default("legacy") // "service" | "product"; historical rows remain unclassified
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  tenantId             String?
  productId            String?
  productCodeSnapshot  String?
  presentationSnapshot String?
  priceSourceSnapshot  String?
  priceVersionSnapshot Int?
  inventoryParent      Transaction? @relation("InventoryItemParent", fields: [tenantId, transactionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryProduct     InventoryProduct? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryMovements   InventoryMovement[]
  inventoryReturn      InventoryReturnLine?
  @@unique([tenantId, transactionId, id, productId], map: "TransactionItem_inventory_identity_key")

  // mapeo de items por transacción (revenue byItem)
  @@index([transactionId])
}

// ── Egresos / Gastos (POS unificado) ──────────────────────────
// category: "supplies" | "utilities" | "rent" | "salary" | "equipment" | "marketing" | "other"
model Expense {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  date          DateTime @default(now())
  category      String   @default("other")
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("cash")
  notes         String?
  createdAt     DateTime @default(now())

  // Entregable 2.3 — Sistema Operativo de Finanzas
  responsible   String?           // nullable: Fase 1 no lo captura; exigido solo por RegisterExpenseUseCase
  status        String   @default("active") // "active" | "voided"
  voidedAt      DateTime?
  voidReason    String?

  @@index([tenantId, date])
  operationalReceipts ExecutionReceipt[]
  @@unique([tenantId, id], map: "Expense_tenant_id_key")
}

// ── Finanzas como Sistema Operativo (Entregable 2.3) ───────────
model DailyClose {
  id       String   @id @default(cuid())
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  date         DateTime
  incomeTotal  Decimal @db.Decimal(10, 2)
  expenseTotal Decimal @db.Decimal(10, 2)
  netAmount    Decimal @db.Decimal(10, 2)
  openingCashAmount Decimal? @db.Decimal(10, 2)
  retainedCashAmount Decimal? @db.Decimal(10, 2)

  // Snapshot congelado del desglose por staff — no una relación (ver finanzas-modelo-persistencia.md)
  staffBreakdown Json

  financialPeriodId String?
  financialPeriod   FinancialPeriod? @relation(fields: [financialPeriodId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId, financialPeriodId])
}

// Fondo confirmado de efectivo. No es una Transaction ni un Expense.
model CashOpening {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  date DateTime
  amount Decimal @db.Decimal(10, 2)
  sourceDailyCloseId String?
  actorId String?
  actorName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
}

model FinancialPeriod {
  id       String   @id @default(cuid())
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  periodStart  DateTime
  periodEnd    DateTime
  incomeTotal  Decimal @db.Decimal(10, 2)
  expenseTotal Decimal @db.Decimal(10, 2)
  netAmount    Decimal @db.Decimal(10, 2)

  // Snapshot congelado — no una relación
  breakdown Json

  dailyCloses DailyClose[]

  createdAt DateTime @default(now())

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId, periodStart])
}

// ── Comisiones (Entregable 7) ─────────────────────────────────
// Registro contable inmutable generado al completar una cita de grooming.
// El precio y el split quedan congelados en el momento del cierre;
// cambios posteriores en catálogo o ficha de mascota no los afectan.
// serviceCategory: "grooming" | "veterinary" | "other"
// priceSource: "manual_override" | "pet_default_price" | "service_base_price"
model Commission {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  // La unicidad real es parcial — como máximo una Commission ACTIVA por cita — y vive
  // como índice único parcial en SQL (WHERE status = 'active'). Ver ADR 009.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  transactionItemId String?
  transactionItem TransactionItem? @relation(fields: [transactionItemId], references: [id], onDelete: Restrict)
  serviceId String?
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  staffId       String?
  staff         Staff?   @relation(fields: [staffId], references: [id])

  resolvedPrice  Decimal  @db.Decimal(10, 2)
  priceSource    String

  splitRate      Decimal  @db.Decimal(5, 4)
  staffShare     Decimal  @db.Decimal(10, 2)
  businessShare  Decimal  @db.Decimal(10, 2)

  serviceCategory String
  completedAt     DateTime

  // Entregable Puente — patrón de anulación (ADR 009): inmutable; la corrección es
  // anulación + nuevo registro, atómicos en un único comando del contexto Staff.
  status        String   @default("active") // "active" | "voided"
  voidedAt      DateTime?
  voidReason    String?
  replacesCommissionId String?
  replacesCommission   Commission?  @relation("CommissionReplacement", fields: [replacesCommissionId], references: [id])
  replacedBy           Commission[] @relation("CommissionReplacement")

  createdAt       DateTime @default(now())

  @@index([tenantId, completedAt])
  @@index([staffId, completedAt])
  @@index([appointmentId])
}

// ── Infraestructura de Eventos (Entregable 3.0, Fase 3) ────────────────────
// Diseño congelado: docs/architecture/technical-design/infraestructura-de-eventos-esquema-fisico.md

// Catálogo global del sistema — no pertenece a ningún tenant (Etapa 5, sección 2):
// un Tipo de Evento como "CitaCompletada" significa lo mismo para todos los negocios.
model EventType {
  id                         String   @id @default(cuid())
  name                       String   @unique
  originContext              String
  payloadContractDescription String?
  active                     Boolean  @default(true)
  createdAt                  DateTime @default(now())

  domainEvents DomainEvent[]
  automationTemplates AutomationTemplate[]
  automationRules     AutomationRule[]
}

// El hecho mismo — inmutable desde su creación (Invariante 1). Payload: la
// representación canónica del hecho dentro de este contexto (Invariante 5),
// nunca interpretada aquí.
model DomainEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  payload     Json
  origin      String
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  deliveries  EventDelivery[]
  automationExecutions AutomationExecution[]

  @@index([tenantId, eventTypeId, occurredAt])
  operationalPublicationIntents PublicationIntent[]
  @@unique([tenantId, id], map: "Event_tenant_id_key")
}

// Certifica, para un Evento y un consumidor, si el hecho fue puesto a su
// disposición. Referencia por id, sin exigir consistencia atómica con el
// Evento (Invariante 6). Cada fila nace en su estado terminal — "pending" es
// un valor previsto para futuras estrategias de entrega, no persistido en
// este entregable (Etapa 5, nota de la aprobación).
model EventDelivery {
  id            String      @id @default(cuid())
  domainEventId String
  domainEvent   DomainEvent @relation(fields: [domainEventId], references: [id], onDelete: Restrict)

  consumer      String
  status        String      // "pending" | "delivered" | "failed"
  failureReason String?
  createdAt     DateTime    @default(now())

  @@index([domainEventId])
  @@index([domainEventId, consumer])
}

// ── Empleados Digitales (Entregable 3.2, Fase 3) ───────────────────────────
// Diseño congelado: docs/architecture/technical-design/empleado-digital-esquema-fisico.md

model DigitalEmployee {
  selectedThreads OperatorThread[]
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  specialization String
  status         String   @default("activo") // "activo" | "pausado"
  createdAt      DateTime @default(now())

  autonomyLimits AgentAutonomyLimit[]
  tasks          AgentTask[]

  @@index([tenantId, specialization])
  operationalRequests OperationalRequest[]
  @@unique([tenantId, id], map: "DE_tenant_id_key")
}

model AgentAutonomyLimit {
  id                String          @id @default(cuid())
  digitalEmployeeId String
  digitalEmployee   DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)
  action            String
  autoApproved      Boolean         @default(false)

  @@unique([digitalEmployeeId, action])
}

model AgentTask {
  id                String          @id @default(cuid())
  digitalEmployeeId String
  digitalEmployee   DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Restrict)
  origin            String
  status            String          @default("en_proceso") // "en_proceso" | "completada" | "escalada"
  result            Json?
  createdAt         DateTime        @default(now())

  decisions   AgentDecision[]
  escalations Escalation[]

  @@index([digitalEmployeeId, status])
  operationalRequests OperationalRequest[]
  @@unique([digitalEmployeeId, id], map: "AT_employee_id_key")
}

model AgentDecision {
  id          String    @id @default(cuid())
  agentTaskId String
  agentTask   AgentTask @relation(fields: [agentTaskId], references: [id], onDelete: Restrict)
  input       Json
  reasoning   String
  action      String
  createdAt   DateTime  @default(now())

  @@index([agentTaskId])
  operationalReceipts ExecutionReceipt[]
  @@unique([agentTaskId, id], map: "AD_task_id_key")
}

model Escalation {
  id              String    @id @default(cuid())
  agentTaskId     String
  agentTask       AgentTask @relation(fields: [agentTaskId], references: [id], onDelete: Restrict)
  assignedStaffId String?
  assignedStaff   Staff?    @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  context         Json
  status          String    @default("pendiente") // "pendiente" | "atendida"
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([assignedStaffId, status])
}

// ── Automatizaciones (Entregable 3.3, Fase 3) ──────────────────────────────
// Diseño congelado: docs/architecture/technical-design/automatizaciones-esquema-fisico.md

model AutomationTemplate {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  triggerEventTypeId  String
  triggerEventType    EventType @relation(fields: [triggerEventTypeId], references: [id], onDelete: Restrict)
  defaultCondition    Json?
  defaultActionType   String
  defaultActionConfig Json
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  rules AutomationRule[]

  @@index([triggerEventTypeId])
}

model AutomationRule {
  id                 String   @id @default(cuid())
  tenantId           String?
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  name               String
  triggerEventTypeId String
  triggerEventType   EventType @relation(fields: [triggerEventTypeId], references: [id], onDelete: Restrict)

  condition    Json?
  actionType   String
  actionConfig Json

  active    Boolean  @default(true)

  templateId String?
  template   AutomationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions AutomationExecution[]

  @@index([tenantId, active])
  @@index([triggerEventTypeId, active])
}

model AutomationExecution {
  id               String   @id @default(cuid())
  automationRuleId String
  automationRule   AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Restrict)

  domainEventId String
  domainEvent   DomainEvent @relation(fields: [domainEventId], references: [id], onDelete: Restrict)

  status        String   // "success" | "failed"
  actionResult  Json?
  failureReason String?

  createdAt DateTime @default(now())

  @@index([automationRuleId, createdAt])
  @@index([domainEventId])
}

// ── API pública, Fase 1 (Ecosistema) ────────────────────────────────────────
// Mecanismo de autenticación de terceros. La key en texto plano nunca se
// persiste — solo su hash (keyHash, único). Sin catálogo de recursos propio
// todavía: este entregable construye únicamente el mecanismo de identidad.
model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  keyHash   String    @unique
  scopes    String[]  @default([])

  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([tenantId])
}

// ── Identidad de Cliente (Ecosistema, Portal del Cliente) ───────────────────
// Segunda capa de identidad, separada de ApiKey (nivel tenant/app) y de la
// sesión de staff (NextAuth). Ninguno de los dos modelos persiste el código
// ni el token en texto plano — solo su hash SHA-256.
model ClientVerificationCode {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  attempts Int    @default(0)

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([tenantId, userId, consumedAt])
}

model ClientSession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([tenantId, userId])
}

// ── Cola durable de mensajes entrantes (Entregable 8.2, Fase 8) ────────────
// Diseño: docs/history/ENTREGABLE_8_2_GATE_REVIEW.md — patrón inspirado en
// inbound_jobs.py de Sancho Agent IA (ver ADR 010), reescrito en Prisma. El
// webhook encola (transacción corta) y responde 200 de inmediato; un worker
// (jobs/inbound-message.job.js) reclama y procesa. ADR 011: checkpoints y
// concesiones recuperan solo pasos seguros; efectos inciertos requieren revisión.
model InboundJob {
  envelopeVersion    Int @default(1)
  channelTenantId    String?
  channelRouteId     String?
  channelParticipantId String?
  channelOrdinal    BigInt?
  channelRouteVersion BigInt?
  channelInputHash  String? @db.Char(64)
  channelResultKind String? @db.VarChar(16)
  channelPrincipalKey String? @db.VarChar(256)
  channelSessionId  String?
  channelModeVersion BigInt?
  channelClaimGeneration BigInt @default(0)
  channelClaimOwner  String? @db.Uuid
  channelParticipant OperatorParticipant? @relation(fields: [channelTenantId, channelRouteId, channelParticipantId], references: [tenantId, routeId, id], onDelete: Restrict, onUpdate: Restrict)
  channelSession    OperatorSession? @relation("JobOperatorSession", fields: [channelTenantId, channelPrincipalKey, channelSessionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  phoneProofs       OperatorLinkChallenge[] @relation("ChallengePhoneProof")
  operatorIncoming  OperatorMessage[] @relation("OperatorIncomingMessage")
  operatorWork      OperatorInboundWork[]
  operatorDeliveries OperatorDelivery[]
  @@unique([channelParticipantId, channelOrdinal], map: "IJ_operator_ordinal_key")
  id              String    @id @default(cuid())
  provider        String    // "whatsapp" — único hoy, deja la puerta abierta a otros canales
  providerEventId String    // wamid (message.id de Meta) del primer mensaje soportado del payload
  payload         Json      // body completo del webhook, tal cual llegó

  status    String    @default("received") // received | claimed | done | failed | needs_review
  attempts  Int       @default(0)
  lastError String?

  phase          String    @default("pending") // pending | processing | ready | sending | complete
  replies        Json?     // Contratos mínimos de envío, en orden; nunca el resultado completo del motor
  replyCursor    Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseExpiresAt DateTime?

  claimedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
}

model OperationalRequest {
  channelWork  OperatorInboundWork[]
  id                  String @id @default(uuid())
  tenantId            String
  principalKey        String @db.VarChar(256)
  requestId           String @db.Uuid
  employeeId          String
  taskId              String @unique(map: "OR_task_key")
  contractVersion     Int
  canonicalVersion    Int
  inputMode           String @db.VarChar(16)
  canonicalInput      Json
  inputHash           String @db.Char(64)
  state               String @default("pendiente") @db.VarChar(24)
  claimGeneration     BigInt @default(0)
  claimOwner          String? @db.Uuid
  claimUntil          DateTime? @db.Timestamptz(3)
  attemptCount        Int @default(0)
  resultCode          String? @db.VarChar(64)
  result              Json?
  lastErrorCode       String? @db.VarChar(80)
  createdAt           DateTime @db.Timestamptz(3)
  updatedAt           DateTime @db.Timestamptz(3)
  tenant              Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employee            DigitalEmployee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  task                AgentTask @relation(fields: [employeeId, taskId], references: [digitalEmployeeId, id], onDelete: Restrict, onUpdate: Restrict)
  actions             OperationalAction[]
  intents             PublicationIntent[]
  @@unique([tenantId, principalKey, requestId], map: "OR_request_key")
  @@unique([tenantId, principalKey, id, taskId], map: "OR_scope_task_key")
  @@index([tenantId, principalKey, createdAt, id], map: "OR_owner_page_idx")
  @@index([state, claimUntil, id], map: "OR_claim_idx")
}

model OperationalAction {
  selectedBy   OperatorThread[]
  channelWork  OperatorInboundWork[]
  interactions OperatorInteraction[]
  id                  String @id @default(uuid())
  tenantId            String
  principalKey        String @db.VarChar(256)
  requestId           String @unique(map: "OA_request_key")
  taskId              String
  kind                String @db.VarChar(24)
  state               String @db.VarChar(16)
  currentRevision     Int
  executionKey        String @unique(map: "OA_execution_key") @db.Uuid
  terminalReason      String? @db.VarChar(80)
  createdAt           DateTime @db.Timestamptz(3)
  closedAt            DateTime? @db.Timestamptz(3)
  request             OperationalRequest @relation(fields: [tenantId, principalKey, requestId, taskId], references: [tenantId, principalKey, id, taskId], onDelete: Restrict, onUpdate: Restrict)
  revisions           ActionRevision[] @relation("AllActionRevisions")
  current             ActionRevision @relation("CurrentActionRevision", fields: [tenantId, principalKey, id, currentRevision], references: [tenantId, principalKey, actionId, number], onDelete: Restrict, onUpdate: Restrict, map: "OA_current_revision_fk")
  receipts            ExecutionReceipt[]
  @@unique([tenantId, principalKey, id], map: "OA_scope_key")
  @@unique([tenantId, principalKey, id, taskId, kind], map: "OA_receipt_scope_key")
  @@index([tenantId, principalKey, state, createdAt, id], map: "OA_owner_page_idx")
}

model ActionRevision {
  reviews      OperatorReview[]
  id                  String @id @default(uuid())
  tenantId            String
  principalKey        String @db.VarChar(256)
  actionId            String
  number              Int
  contractVersion     Int
  canonicalVersion    Int
  validationState     String @db.VarChar(16)
  payload             Json
  missingFields       Json
  preview             Json
  productContext      Json?
  payloadHash         String @db.Char(64)
  createdAt           DateTime @db.Timestamptz(3)
  expiresAt           DateTime? @db.Timestamptz(3)
  action              OperationalAction @relation("AllActionRevisions", fields: [tenantId, principalKey, actionId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor          OperationalAction[] @relation("CurrentActionRevision")
  receipts            ExecutionReceipt[]
  @@unique([tenantId, principalKey, actionId, number], map: "AR_number_key")
  @@index([validationState, expiresAt, actionId], map: "AR_expiry_idx")
}

model ExecutionReceipt {
  interactions OperatorInteraction[]
  id                   String @id @default(uuid())
  tenantId             String
  principalKey         String @db.VarChar(256)
  actionId             String @unique(map: "ER_action_key")
  taskId               String
  kind                 String @db.VarChar(24)
  revisionNumber       Int
  payloadHash          String @db.Char(64)
  executionKey         String @unique(map: "ER_execution_key") @db.Uuid
  contractVersion      Int
  decisionId           String @unique(map: "ER_decision_key")
  expenseId            String? @unique(map: "ER_expense_key")
  inventoryOperationId String? @unique(map: "ER_inventory_key")
  actorName            String @db.VarChar(160)
  actorRole            String @db.VarChar(32)
  resultVersion        Int
  result               Json
  confirmedAt          DateTime @db.Timestamptz(3)
  action               OperationalAction @relation(fields: [tenantId, principalKey, actionId, taskId, kind], references: [tenantId, principalKey, id, taskId, kind], onDelete: Restrict, onUpdate: Restrict)
  revision             ActionRevision @relation(fields: [tenantId, principalKey, actionId, revisionNumber], references: [tenantId, principalKey, actionId, number], onDelete: Restrict, onUpdate: Restrict)
  decision             AgentDecision @relation(fields: [taskId, decisionId], references: [agentTaskId, id], onDelete: Restrict, onUpdate: Restrict)
  expense              Expense? @relation(fields: [tenantId, expenseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryOperation   InventoryOperation? @relation(fields: [tenantId, principalKey, inventoryOperationId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  intents              PublicationIntent[]
  @@unique([tenantId, principalKey, id], map: "ER_scope_key")
  @@index([tenantId, principalKey, confirmedAt, id], map: "ER_owner_page_idx")
}

model PublicationIntent {
  id                  String @id @default(uuid())
  tenantId            String
  principalKey        String @db.VarChar(256)
  requestId           String
  taskId              String
  receiptId           String?
  causeKey            String @db.VarChar(200)
  ordinal             Int
  eventName           String @db.VarChar(100)
  origin              String @db.VarChar(80)
  payload             Json
  occurredAt          DateTime @db.Timestamptz(3)
  canonicalVersion    Int
  envelopeHash        String @db.Char(64)
  certificationState  String @default("pendiente") @db.VarChar(24)
  domainEventId       String? @unique(map: "PI_event_key")
  claimGeneration     BigInt @default(0)
  claimOwner          String? @db.Uuid
  claimUntil          DateTime? @db.Timestamptz(3)
  certificationTries  BigInt @default(0)
  nextAttemptAt       DateTime @db.Timestamptz(3)
  certificationError  String? @db.VarChar(80)
  certifiedAt         DateTime? @db.Timestamptz(3)
  notificationState   String @default("no_iniciada") @db.VarChar(24)
  notificationId      String? @unique(map: "PI_notification_key") @db.Uuid
  notificationStarted DateTime? @db.Timestamptz(3)
  notificationEnded   DateTime? @db.Timestamptz(3)
  notificationCode    String? @db.VarChar(80)
  notificationEvidence Json?
  createdAt           DateTime @db.Timestamptz(3)
  updatedAt           DateTime @db.Timestamptz(3)
  request             OperationalRequest @relation(fields: [tenantId, principalKey, requestId, taskId], references: [tenantId, principalKey, id, taskId], onDelete: Restrict, onUpdate: Restrict)
  receipt             ExecutionReceipt? @relation(fields: [tenantId, principalKey, receiptId], references: [tenantId, principalKey, id], onDelete: Restrict, onUpdate: Restrict)
  event               DomainEvent? @relation(fields: [tenantId, domainEventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([requestId, causeKey, ordinal], map: "PI_emission_key")
  @@index([certificationState, nextAttemptAt, claimUntil, id], map: "PI_certify_idx")
  @@index([notificationState, certifiedAt, id], map: "PI_notify_idx")
  @@index([tenantId, principalKey, requestId, createdAt, id], map: "PI_owner_idx")
}
