generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String   @unique
  email     String?
  plan      String   @default("free")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   // active / past_due / canceled / trialing
  planExpiresAt        DateTime?

  // Perfil del negocio (TAREA 18)
  description   String?
  address       String?
  logoUrl       String?
  businessHours Json?   // { mon: { open: "08:00", close: "18:00", active: true }, ... }

  users         User[]
  pets          Pet[]
  appointments  Appointment[]
  conversations Conversation[]
  services      Service[]
  staff         Staff[]
  nextActions   PetNextAction[]
  transactions  Transaction[]
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name      String
  role      String   // "vet" | "groomer" | "admin"
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String
  category    String   // "veterinary" | "grooming" | "other"
  duration    Int      // minutos
  basePrice   Decimal? @db.Decimal(10, 2)
  requiresAppointment Boolean @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name      String?
  email     String?
  address   String?
  notes              String?
  lastReminderSentAt DateTime?
  createdAt          DateTime @default(now())

  pets              Pet[]
  conversations     Conversation[]
  appointments      Appointment[]
  memoryEmbeddings  MemoryEmbedding[]
  transactions      Transaction[]
}

model Pet {
  id        String   @id @default(cuid())
  name      String
  type      String
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  ownerId   String
  owner     User @relation(fields: [ownerId], references: [id])

  breed      String?
  gender     String?
  birthDate  DateTime?
  weight     Float?
  sterilized Boolean?
  notes      String?

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  nextActions    PetNextAction[]
  transactions   Transaction[]

  groomingReminderSent Boolean @default(false)

  createdAt DateTime @default(now())
}

// status: "pending" | "done" | "dismissed"
// type:   "control" | "vaccine" | "grooming" | "exam" | "treatment" | "other"
model PetNextAction {
  id       String  @id @default(cuid())
  petId    String
  pet      Pet     @relation(fields: [petId], references: [id])
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  type   String
  notes  String?
  dueAt  DateTime
  status String   @default("pending")

  // Trazabilidad — qué generó esta acción
  sourceRecordId      String?
  sourceAppointmentId String?

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalRecord {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])

  // Link to the originating appointment (TAREA 10)
  appointmentId String?   @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // Attending professional
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  type      String
  title     String
  detail    String?
  date      DateTime?

  // Clinical fields (TAREA 10) — all optional for backward compatibility
  reason          String?
  findings        String?
  diagnosis       String?
  treatment       String?
  recommendations String?
  weight          Float?
  nextControlAt   DateTime?

  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  intent      String?
  step        String?
  /// Estado del wizard de reserva (pet_name, scheduling_date_key, etc.)
  sessionData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages          Message[]
  memoryEmbeddings  MemoryEmbedding[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  role            String
  content         String

  createdAt       DateTime @default(now())

  memoryEmbeddings MemoryEmbedding[]
}

/// Embeddings semánticos (pgvector). Dimensión 1536 = text-embedding-3-small / similar.
model MemoryEmbedding {
  id             String   @id @default(cuid())

  userId         String
  user           User @relation(fields: [userId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  messageId      String?
  message        Message? @relation(fields: [messageId], references: [id])

  content        String
  embedding      Unsupported("vector(1536)")

  metadata       Json?

  createdAt      DateTime @default(now())
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  petId       String?
  pet         Pet? @relation(fields: [petId], references: [id])

  petName     String
  petType     String

  serviceType String

  // Operational fields (TAREA 9)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id])
  price       Decimal? @db.Decimal(10, 2)
  startedAt   DateTime?
  endedAt     DateTime?

  date        DateTime
  // status: pending | confirmed | arrived | in_progress | completed | no_show | cancelled
  status      String   @default("pending")

  googleEventId String?

  address       String?
  groomingBreed String?
  groomingSize  String?

  reminderSent  Boolean  @default(false)
  followUpSent  Boolean  @default(false)

  medicalRecord MedicalRecord?
  transaction   Transaction?

  createdAt   DateTime @default(now())
}

// ── POS / Facturación (TAREA 17) ──────────────────────────────
// paymentMethod: "cash" | "transfer" | "card" | "other"
model Transaction {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  petId         String?
  pet           Pet?     @relation(fields: [petId], references: [id])
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  total         Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("cash")
  notes         String?
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  items         TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  description   String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
}